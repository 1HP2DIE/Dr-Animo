<?xml version="1.0" encoding="utf-8"?>
<!--
  The catalog DB is a rebuildable cache of the catalogue API (~12 MB). Excluding it keeps
  Auto Backup off the quota and guarantees a restore never resurrects a half-written schema.
-->
<full-backup-content>
    <exclude
        domain="database"
        path="animo.db" />
    <exclude
        domain="database"
        path="animo.db-wal" />
    <exclude
        domain="database"
        path="animo.db-shm" />
    <exclude
        domain="file"
        path="datastore" />
    <!-- The media itself lives in the external files dir, which is not backed up; a restored row
         would claim a file that does not exist, with no way to start the download again. -->
    <exclude
        domain="file"
        path="downloads.json" />
</full-backup-content>
